# ChatGPT web → Courier bridge MCP server (issue #61, phase 1).
#
# NOT YET INSTALLED — phase 1 runs as foreground processes for E2E
# verification. Install only with explicit operator approval (phase 2+).
# Public access is via Caddy (mcp.courier.blackcandletech.com → 127.0.0.1:8472);
# this unit binds localhost only.
#
# This server runs as its own unprivileged user (courier-bridge-mcp),
# separate from the gateway's courier-bridge user (issue #86): a
# compromise of the MCP server must not imply access to the gateway's
# bridge identity or bridge.db.
#
# Setup (once, as root on the VPS), after the gateway unit:
#   useradd -r -s /usr/sbin/nologin -d /opt/courier-bridge-mcp courier-bridge-mcp
#   mkdir -p /opt/courier-bridge-mcp && chown courier-bridge-mcp:courier-bridge-mcp /opt/courier-bridge-mcp
#   chmod 700 /opt/courier-bridge-mcp
#   # /etc/courier-bridge-mcp.env (0600, root:root):
#   #   COURIER_BRIDGE_TOKEN=<ingest token>
#   #   COURIER_BRIDGE_ALLOWED_CALLERS=<comma-separated Black Candle emails, issue #94>
#   #   COURIER_BRIDGE_PUBLIC_URL=<public MCP URL, default https://mcp.courier.blackcandletech.com>
#   #   COURIER_BRIDGE_AUTHD_URL=<authd URL, default https://auth.blackcandletech.com>
#   # (one env file / unit instance per authorized bridge user set)
[Unit]
Description=Courier ChatGPT-web bridge MCP server (issue #61)
After=network.target courier-bridge-gateway.service

[Service]
Type=simple
User=courier-bridge-mcp
Group=courier-bridge-mcp
WorkingDirectory=/opt/courier-bridge-mcp
EnvironmentFile=/etc/courier-bridge-mcp.env
# /opt/courier-bridge-mcp is the MCP server's only writable path.
# StateDirectory can't express /opt paths, so ReadWritePaths is used;
# ProtectSystem=strict keeps the rest of the filesystem read-only
# (/etc/courier-bridge-mcp.env needs read only).
ReadWritePaths=/opt/courier-bridge-mcp
ExecStart=/opt/courier-bridge-mcp/courier-bridge-mcp --addr 127.0.0.1:8472 --gateway http://127.0.0.1:8473
Restart=always
RestartSec=5
# The MCP server logs to stdout (journal); it writes no log files of its own.

# --- Sandboxing (issue #114) ---
# The MCP server serves localhost HTTPS and dials the gateway
# (127.0.0.1:8473) plus authd for OAuth client discovery.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
# TCP/UDP only (+AF_UNIX, harmless): binds 127.0.0.1:8472, dials the
# gateway and auth.blackcandletech.com.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallArchitectures=native
# No capabilities needed: ports 8470+ are unprivileged.
CapabilityBoundingSet=
UMask=0027
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
